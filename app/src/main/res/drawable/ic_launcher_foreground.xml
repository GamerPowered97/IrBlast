<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outermost IR Wave Arc (Radius 28dp, safe within 33dp mask) -->
    <path
        android:pathData="M 32,38 A 28,28 0 0,1 76,38"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="32"
                android:startY="26"
                android:endX="76"
                android:endY="26">
                <item android:offset="0.0" android:color="#44FF3366" />
                <item android:offset="0.5" android:color="#CCFF477E" />
                <item android:offset="1.0" android:color="#44FF3366" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mid IR Wave Arc (Radius 21dp) -->
    <path
        android:pathData="M 37.5,43.5 A 21,21 0 0,1 70.5,43.5"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="37.5"
                android:startY="33"
                android:endX="70.5"
                android:endY="33">
                <item android:offset="0.0" android:color="#887C4DFF" />
                <item android:offset="0.5" android:color="#FFFF5252" />
                <item android:offset="1.0" android:color="#887C4DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner IR Wave Arc (Radius 14dp) -->
    <path
        android:pathData="M 43.5,48.5 A 14,14 0 0,1 64.5,48.5"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="43.5"
                android:startY="40"
                android:endX="64.5"
                android:endY="40">
                <item android:offset="0.0" android:color="#CC6C5CE7" />
                <item android:offset="0.5" android:color="#FFFF6584" />
                <item android:offset="1.0" android:color="#CC6C5CE7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Emitter Diode Core Halo -->
    <path
        android:pathData="M 54,52 m -5,0 a 5,5 0 1,1 10,0 a 5,5 0 1,1 -10,0"
        android:fillColor="#33FF3366" />

    <!-- Emitter Diode Core / LED lens -->
    <path
        android:pathData="M 54,52 m -3,0 a 3,3 0 1,1 6,0 a 3,3 0 1,1 -6,0"
        android:fillColor="#FFFF3B69" />

    <!-- Emitter Lens Specular Glint -->
    <path
        android:pathData="M 53,51 m -1,0 a 1,1 0 1,1 2,0 a 1,1 0 1,1 -2,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Remote Body Outer Shell (Height 27dp, y=57..84, completely inside 33dp mask) -->
    <path
        android:pathData="M 44,57
                          h 20
                          a 4,4 0 0,1 4,4
                          v 17
                          a 6,6 0 0,1 -6,6
                          h -16
                          a 6,6 0 0,1 -6,-6
                          v -17
                          a 4,4 0 0,1 4,-4
                          z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="57"
                android:endX="68"
                android:endY="84">
                <item android:offset="0.0" android:color="#FF242B4E" />
                <item android:offset="1.0" android:color="#FF13172E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Remote Body Subtle Border Outline -->
    <path
        android:pathData="M 44,57
                          h 20
                          a 4,4 0 0,1 4,4
                          v 17
                          a 6,6 0 0,1 -6,6
                          h -16
                          a 6,6 0 0,1 -6,-6
                          v -17
                          a 4,4 0 0,1 4,-4
                          z"
        android:fillColor="#00000000"
        android:strokeWidth="1.2"
        android:strokeColor="#557B8FFF" />

    <!-- Remote Power / Nav Accent Dot -->
    <path
        android:pathData="M 54,65 m -2.5,0 a 2.5,2.5 0 1,1 5,0 a 2.5,2.5 0 1,1 -5,0"
        android:fillColor="#FFFF477E" />

    <!-- Remote Keypad Accent Lines -->
    <path
        android:pathData="M 47,72 h 14 M 49,77 h 10"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeColor="#448FA0F7" />

</vector>